{
  "name": "mini-sentry",
  "private": true,
  "type": "module",
  "description": "Open-source error monitoring service: SDK, ingestion API, grouping worker and dashboard.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mini-sentry/api dev",
    "db:migrate": "pnpm --filter @mini-sentry/db migrate:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "example:browser": "node examples/serve.mjs",
    "test": "pnpm -r --if-present test",
    "dev:worker": "pnpm --filter @mini-sentry/worker dev",
    "dev:dashboard": "pnpm --filter @mini-sentry/dashboard dev",
    "seed:demo": "node scripts/seed-demo.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @mini-sentry/sdk --filter @mini-sentry/cli build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "~0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
