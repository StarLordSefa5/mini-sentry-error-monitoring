DATABASE_URL=postgresql://minisentry:minisentry@localhost:5432/minisentry
REDIS_URL=redis://localhost:6379
PORT=4000
# Base URL the SDK sends events to; used to build each project's DSN.
PUBLIC_URL=http://localhost:4000
# Set to true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false
# Dashboard address, used for links in alert messages.
DASHBOARD_URL=http://localhost:5173
# Events accepted per project per minute; the rest are rejected with 429.
RATE_LIMIT_PER_MINUTE=1000
# Development only: accept any http(s) webhook URL, not just Discord and Slack.
WEBHOOK_ALLOW_ANY_HOST=false
