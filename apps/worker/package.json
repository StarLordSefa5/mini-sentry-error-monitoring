{
  "name": "@mini-sentry/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Processes queued events and groups them into issues.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mini-sentry/db": "workspace:*",
    "@mini-sentry/shared": "workspace:*",
    "bullmq": "^6.3.16",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
