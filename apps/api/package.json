{
  "name": "@mini-sentry/api",
  "version": "0.0.0",
  "private": true,
  "description": "Ingestion API and dashboard API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
