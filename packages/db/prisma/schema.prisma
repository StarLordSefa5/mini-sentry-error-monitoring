generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  projects     Project[]
}

/// Login session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id              String      @id @default(cuid())
  name            String
  /// Public key used by the SDK. It ships in browser code, so it only grants event writes.
  apiKey          String      @unique
  ownerId         String
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Discord or Slack incoming webhook notified on new issues and regressions.
  alertWebhookUrl String?
  /// SHA-256 of the secret token CI uses to upload source maps. Unlike apiKey it is never public.
  uploadTokenHash String?
  createdAt       DateTime    @default(now())
  issues          Issue[]
  events          Event[]
  sourceMaps      SourceMap[]

  @@index([ownerId])
}

enum IssueStatus {
  unresolved
  resolved
  ignored
}

/// Events with the same fingerprint, grouped.
model Issue {
  /// Generated by Postgres: the worker inserts issues with raw INSERT ... ON CONFLICT.
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint String
  type        String
  message     String
  /// Where it happened, e.g. "checkout in /assets/cart.js": the top in-app frame of the first event.
  culprit     String?
  status      IssueStatus @default(unresolved)
  count       Int         @default(0)
  firstSeen   DateTime    @default(now())
  lastSeen    DateTime    @default(now())
  events      Event[]

  @@unique([projectId, fingerprint])
  @@index([projectId, lastSeen])
  @@index([projectId, status, lastSeen])
}

/// A single error occurrence as sent by the SDK.
model Event {
  id          String   @id @default(cuid())
  /// UUID generated by the SDK; unique so a retried event is stored once.
  eventId     String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null until the worker groups the event (week 3).
  issueId     String?
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  platform    String
  type        String
  message     String
  stack       String?
  frames      Json
  url         String?
  userAgent   String?
  release     String?
  environment String?
  /// What happened just before the error (clicks, requests, logs), oldest first.
  breadcrumbs Json?
  timestamp   DateTime
  receivedAt  DateTime @default(now())

  @@index([projectId, receivedAt])
  @@index([issueId, receivedAt])
}

/// Source map for one minified file of one release, used to turn minified stack frames back into
/// original file, line and function names.
model SourceMap {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release   String
  /// URL path of the minified file this map belongs to, e.g. "/assets/index-BxK3a9Qz.js".
  filePath  String
  content   String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, release, filePath])
}
