generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  projects     Project[]
}

/// Login session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  /// Public key used by the SDK. It ships in browser code, so it only grants event writes.
  apiKey    String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  issues    Issue[]
  events    Event[]

  @@index([ownerId])
}

enum IssueStatus {
  unresolved
  resolved
  ignored
}

/// Events with the same fingerprint, grouped.
model Issue {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint String
  type        String
  message     String
  status      IssueStatus @default(unresolved)
  count       Int         @default(0)
  firstSeen   DateTime    @default(now())
  lastSeen    DateTime    @default(now())
  events      Event[]

  @@unique([projectId, fingerprint])
  @@index([projectId, lastSeen])
}

/// A single error occurrence as sent by the SDK.
model Event {
  id         String   @id @default(cuid())
  /// UUID generated by the SDK; unique so a retried event is stored once.
  eventId    String   @unique
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null until the worker groups the event (week 3).
  issueId    String?
  issue      Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  type       String
  message    String
  frames     Json
  url        String?
  userAgent  String?
  timestamp  DateTime
  receivedAt DateTime @default(now())

  @@index([projectId, receivedAt])
  @@index([issueId, timestamp])
}
