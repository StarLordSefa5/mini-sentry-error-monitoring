{
  "name": "@mini-sentry/sdk",
  "version": "0.1.0",
  "description": "Error monitoring SDK for the browser and Node.js: captures uncaught errors with stack traces and breadcrumbs and sends them to Mini Sentry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mini-sentry/shared": "workspace:*",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "author": "Sefa",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "error-monitoring",
    "error-tracking",
    "crash-reporting",
    "stack-trace",
    "breadcrumbs",
    "sentry"
  ],
  "engines": {
    "node": ">=18"
  }
}
